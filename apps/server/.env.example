# Public HTTPS origin used by all clients: no path, query or fragment.
HAKO_PUBLIC_URL=https://monitor.example.com

# Optional comma-separated IPs/CIDRs of reverse proxies as seen by the server.
# Only these peers may supply X-Forwarded-For. Empty means use the connection IP.
# Example for a native host proxy (Docker may use a different gateway IP):
# HAKO_TRUSTED_PROXIES=127.0.0.1,::1
HAKO_TRUSTED_PROXIES=

# Optional Apple Push for notification webhooks. The key file must be readable by Hako.
# APNS_TEAM_ID=
# APNS_KEY_ID=
# APNS_BUNDLE_ID=me.stackli.hako
# APNS_KEY_FILE=/app/config/AuthKey.p8
# Optional Base64 encoding of a 32-byte key. Otherwise the gateway generates one in its data directory.
# HAKO_NOTIFICATION_ENCRYPTION_KEY=
