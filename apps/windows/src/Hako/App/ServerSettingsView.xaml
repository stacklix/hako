<UserControl x:Class="Hako.Shell.ServerSettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel>
   <TextBlock Text="服务器设置" FontSize="26" FontWeight="Bold" Margin="0,12,0,24"/>
   <TextBlock Text="服务器 URL"/><TextBox x:Name="ServerUrl" ToolTip="https://monitor.example.com"/>
   <TextBlock Text="账号"/><TextBox x:Name="Username"/>
   <TextBlock Text="局域网直连端口"/><TextBox x:Name="DirectPort"/>
   <TextBlock Text="0 表示关闭。局域网直连无需认证，可独立于服务器使用代码工坊。" TextWrapping="Wrap" Foreground="#526175" Margin="0,8"/>
   <Button Content="保存局域网配置" Click="SaveDirectClick"/>
   <TextBlock Text="RSA 设备公私钥对" FontWeight="SemiBold"/>
   <TextBlock x:Name="KeyStatus" Text="尚未配置" TextWrapping="Wrap" Margin="0,8"/>
   <WrapPanel>
    <Button Content="导入 PEM 私钥" Click="ImportClick"/>
    <Button Content="生成公私钥对" Click="GenerateClick"/>
    <Button x:Name="ExportPublicKey" Content="导出公钥" Click="ExportClick" IsEnabled="False"/>
   </WrapPanel>
   <TextBlock Text="生成或导入后，私钥立即经当前 Windows 用户加密保存。将导出的公钥登记到服务端，再保存并连接。" TextWrapping="Wrap" Margin="0,10,0,20" Foreground="#526175"/>
   <WrapPanel><Button x:Name="SaveButton" Content="保存并连接 / 重新连接" Click="SaveClick"/><Button Content="清除配置并断开" Click="ClearClick"/></WrapPanel>
   <TextBlock x:Name="Message" TextWrapping="Wrap" Margin="0,12"/>
   <Border BorderBrush="#DDE2E8" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,20,0,0">
    <StackPanel>
     <TextBlock Text="启动设置" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
     <CheckBox x:Name="StartupToggle" Content="登录 Windows 后自动启动" Checked="StartupChanged" Unchecked="StartupChanged" Padding="0,4"/>
     <TextBlock Text="在托盘后台运行并自动连接服务器，不弹出主窗口。切换后立即生效。" TextWrapping="Wrap" Foreground="#526175" Margin="0,8,0,0"/>
     <TextBlock x:Name="StartupMessage" TextWrapping="Wrap" Margin="0,8,0,12"/>
    </StackPanel>
   </Border>
  </StackPanel>
 </ScrollViewer>
</UserControl>
