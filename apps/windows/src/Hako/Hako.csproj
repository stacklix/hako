<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Kage.ico</ApplicationIcon>
    <AssemblyName>Kage</AssemblyName>
    <Version>1.5.14</Version>
    <Product>Kage</Product>
    <Title>Kage</Title>
    <Description>Kage Windows Agent for Hako</Description>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\Kage.ico"/>
    <EmbeddedResource Include="Assets\scrcpy-server-v3.3.4" LogicalName="Hako.scrcpy-server-v3.3.4"/>
    <EmbeddedResource Include="Assets\hako-video-api19.jar" LogicalName="Hako.video-api19"/>
    <EmbeddedResource Include="Assets\scrcpy-LICENSE.txt" LogicalName="Hako.scrcpy-LICENSE.txt"/>
  </ItemGroup>
</Project>
