<UserControl x:Class="Hako.Features.SystemMonitor.MonitorView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel>
  <TextBlock Text="设备监控" FontSize="26" FontWeight="Bold" Margin="0,12,0,12"/>
  <TextBlock Text="按需采样本机资源，并响应管理客户端的查询。" Foreground="#526175" Margin="0,0,0,32"/>
  <TextBlock Text="CPU 使用率" FontSize="16"/><TextBlock x:Name="Cpu" Text="—" FontSize="44" FontWeight="SemiBold" Margin="0,8,0,24"/>
  <TextBlock Text="内存使用率" FontSize="16"/><TextBlock x:Name="Memory" Text="—" FontSize="44" FontWeight="SemiBold" Margin="0,8,0,4"/>
  <TextBlock x:Name="MemorySize" Text="尚未采样" FontSize="16" Foreground="#526175" Margin="0,0,0,24"/>
  <Button x:Name="Refresh" Content="刷新本机状态" Click="RefreshClick" HorizontalAlignment="Left"/>
  <TextBlock x:Name="SampleTime" TextWrapping="Wrap" Margin="0,16" Foreground="#526175"/>
 </StackPanel>
</UserControl>
