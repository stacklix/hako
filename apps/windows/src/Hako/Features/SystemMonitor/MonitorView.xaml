<UserControl x:Class="Hako.Features.SystemMonitor.MonitorView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <DataTemplate x:Key="ListenerPortTemplate">
   <Expander Header="{Binding Title}" Margin="0,0,0,10" HorizontalContentAlignment="Stretch">
    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="16,8,0,8"/>
   </Expander>
  </DataTemplate>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto">
 <StackPanel>
  <TextBlock Text="设备监控" FontSize="26" FontWeight="Bold" Margin="0,12,0,12"/>
  <TextBlock Text="按需采样本机资源，并响应管理客户端的查询。" Foreground="#526175" Margin="0,0,0,32"/>
  <TextBlock Text="CPU 使用率" FontSize="16"/><TextBlock x:Name="Cpu" Text="—" FontSize="44" FontWeight="SemiBold" Margin="0,8,0,24"/>
  <TextBlock Text="内存使用率" FontSize="16"/><TextBlock x:Name="Memory" Text="—" FontSize="44" FontWeight="SemiBold" Margin="0,8,0,4"/>
  <TextBlock x:Name="MemorySize" Text="尚未采样" FontSize="16" Foreground="#526175" Margin="0,0,0,24"/>
  <TextBlock Text="网络速率" FontSize="16"/>
  <TextBlock x:Name="NetworkRate" Text="—" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,4" TextWrapping="Wrap"/>
  <TextBlock x:Name="NetworkScope" Text="物理网卡合计，含局域网流量" FontSize="14" Foreground="#526175" Margin="0,0,0,24" TextWrapping="Wrap"/>
  <Button x:Name="Refresh" Content="刷新本机状态" Click="RefreshClick" HorizontalAlignment="Left"/>
  <TextBlock x:Name="SampleTime" TextWrapping="Wrap" Margin="0,16" Foreground="#526175"/>
  <TextBlock Text="监听端口" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,8"/>
  <TextBlock x:Name="ListenerStatus" Text="刷新后查看 TCP 监听及 UDP 绑定端口" Foreground="#526175" TextWrapping="Wrap" Margin="0,0,0,12"/>
  <TabControl>
   <TabItem x:Name="UserListenerTab" Header="用户">
    <StackPanel Margin="8">
     <TextBlock x:Name="UserListenerEmpty" Text="刷新后查看用户监听端口" Foreground="#526175" Margin="0,0,0,8"/>
     <ItemsControl x:Name="UserListenerPorts" ItemTemplate="{StaticResource ListenerPortTemplate}"/>
    </StackPanel>
   </TabItem>
   <TabItem x:Name="SystemListenerTab" Header="系统">
    <StackPanel Margin="8">
     <TextBlock x:Name="SystemListenerEmpty" Text="刷新后查看系统监听端口" Foreground="#526175" Margin="0,0,0,8"/>
     <ItemsControl x:Name="ListenerPorts" ItemTemplate="{StaticResource ListenerPortTemplate}"/>
    </StackPanel>
   </TabItem>
  </TabControl>
 </StackPanel>
 </ScrollViewer>
</UserControl>
